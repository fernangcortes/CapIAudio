rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOwnerOfDoc(existingData) {
      return isSignedIn() && existingData.userId == request.auth.uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Custom Entity Validations ---

    function isValidRecordingSession(data) {
      return data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.date is string && data.date.size() <= 50
        && data.modeId is string && data.modeId.size() <= 50
        && data.markers is list && data.markers.size() <= 500
        && (data.duration is number || data.duration is float)
        && data.userId == request.auth.uid
        && (!('transcription' in data) || (data.transcription is string && data.transcription.size() <= 200000))
        && (!('summary' in data) || (data.summary is string && data.summary.size() <= 50000))
        && (!('tasks' in data) || (data.tasks is list && data.tasks.size() <= 100))
        && (!('decisions' in data) || (data.decisions is list && data.decisions.size() <= 100))
        && (!('intelligentIndex' in data) || (data.intelligentIndex is list && data.intelligentIndex.size() <= 100))
        && (!('setupData' in data) || data.setupData is map)
        && (!('cinemaMetadata' in data) || data.cinemaMetadata is map);
    }

    function isValidCustomMode(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 100
        && data.icon is string && data.icon.size() <= 50
        && data.description is string && data.description.size() <= 500
        && data.defaultButtons is list && data.defaultButtons.size() <= 100
        && data.userId == request.auth.uid;
    }

    function isValidCinemaProject(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 100
        && data.scenes is list && data.scenes.size() <= 100
        && data.userId == request.auth.uid;
    }

    // --- Rule Definitions for Collections ---

    // Sessions Collection
    match /sessions/{sessionId} {
      allow create: if isSignedIn()
        && isValidId(sessionId)
        && isValidRecordingSession(incoming());

      allow get: if isOwnerOfDoc(existing());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow update: if isSignedIn()
        && isOwnerOfDoc(existing())
        && isValidRecordingSession(incoming())
        && incoming().userId == existing().userId
        && incoming().id == existing().id;

      allow delete: if isOwnerOfDoc(existing());
    }

    // Custom Modes Collection
    match /custom_modes/{modeId} {
      allow create: if isSignedIn()
        && isValidId(modeId)
        && isValidCustomMode(incoming());

      allow get: if isOwnerOfDoc(existing());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow update: if isSignedIn()
        && isOwnerOfDoc(existing())
        && isValidCustomMode(incoming())
        && incoming().userId == existing().userId
        && incoming().id == existing().id;

      allow delete: if isOwnerOfDoc(existing());
    }

    // Cinema Projects Collection
    match /cinema_projects/{projectId} {
      allow create: if isSignedIn()
        && isValidId(projectId)
        && isValidCinemaProject(incoming());

      allow get: if isOwnerOfDoc(existing());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow update: if isSignedIn()
        && isOwnerOfDoc(existing())
        && isValidCinemaProject(incoming())
        && incoming().userId == existing().userId
        && incoming().id == existing().id;

      allow delete: if isOwnerOfDoc(existing());
    }
  }
}
